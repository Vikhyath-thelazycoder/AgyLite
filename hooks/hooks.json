{
  "description": "Agylite: Level-0 bootstrap at session start (D-042) and the route of every prompt (UserPromptSubmit, D-048). The optional Unlazy Stop hook is registered centrally by `agylite runtime unlazy-hook --enable`.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/agylite\" bootstrap --host claude-code",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/agylite\" hook prompt --host claude-code",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
